  "story": [
    {
      "id": "s1",
      "title": "到处说要往东走",
      "text": "班超让人到处说：我们要往东边走。",
      "narration": "班超在西域，想让守军把眼睛都挪到东边去。他叫人到处说：我们要往东边走啦！守军一听，把兵都调到东边守着。"
    },
    {
      "id": "s2",
      "title": "连夜从西边过去",
      "text": "他连夜从西边过去了。",
      "narration": "当天夜里，班超带着人从西边悄悄地过去了。守军还盯着东边，那里什么也没有 —— 等他明白过来，班超早就走远了。"
    }
  ],
  "keyMoment": {
    "beatId": "s1",
    "question": "想让看守往东边看，怎么做？",
    "options": [
      {
        "id": "noise",
        "text": "把热闹都摆到东边",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "shout",
        "text": "从东边喊他过去",
        "isCanonical": false,
        "hint": "喊一声，他一看就明白你在骗他。"
      },
      {
        "id": "rush",
        "text": "直接冲过去",
        "isCanonical": false,
        "hint": "灯正照着你呢 —— 一冲就被看见。"
      }
