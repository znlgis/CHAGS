  "story": [
    {
      "id": "s1",
      "title": "一模一样的一排人",
      "text": "对面一排人，穿得一模一样。",
      "narration": "唐朝安史之乱的时候，张巡守着一座城。对面的队伍排成一阵，衣甲一模一样，看不出谁在发号施令 —— 找不到那一个，就不知道该从哪里使劲。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "一枝蒿箭",
      "text": "一枝蒿箭射过去，那个回头喝令的人 —— 就是他。",
      "narration": "张巡让人用蒿草削成箭。蒿箭没有杀伤，射在身上不痛不痒；中箭的人自己不在意，旁边的人却回头去看 —— 那一个回头喝令的人，就是领头的尹子奇。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s1",
    "question": "怎么在一群一模一样的人里找到领头的？",
    "options": [
