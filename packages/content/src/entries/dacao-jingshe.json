  "story": [
    {
      "id": "s1",
      "title": "案卷上的名字",
      "text": "案卷上出现了自己的名字，王鲁心里发慌。",
      "narration": "五代的时候，王鲁在当涂县做县令。一天，百姓联名递上一叠状纸，告的是他手下的主簿。他一行一行往下看，越看越坐不住 —— 状纸上写的那些事，他自己也没少做，看着看着，像是看见了自己的名字。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "拨草见蛇",
      "text": "他拿竹竿拨开草丛 —— 蛇一窜，全院子都知道了。",
      "narration": "打草本来是想把草丛里的蛇赶出来，可草一响，蛇先知道。王鲁在状纸边上写了一句话：你不过是拨了拨草，我这条蛇已经惊了。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s1",
    "question": "想知道草丛里有什么，又不想让所有人都知道，怎么办？",
    "options": [
      {
        "id": "poke",
        "text": "先轻轻拨一处，看清楚再说",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "flatten",
        "text": "把整片草都踩平",
        "isCanonical": false,
        "hint": "整片都踩平，动静更大，全院子都知道了。"
      },
      {
        "id": "ignore",
        "text": "不管它，直接走过去",
        "isCanonical": false,
        "hint": "草丛里有什么，就永远不知道了。"
      }
    ],
    "reveal": "先拨一处看清楚，再决定动不动手 —— 可草一响，蛇也会听见。"
  },
  "misconceptions": [
    "想看清楚，就得把整片草都翻一遍",
    "试探是白费力气，直接上就行"
  ],
