  "story": [
    {
      "id": "s1",
      "title": "队伍散了",
      "text": "队伍散了，只剩一面旧旗。",
      "narration": "公元前二〇九年，大雨把去戍边的队伍困在大泽乡。人一个接一个跑散，营地里只剩下一面倒在泥里的旧旗。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "旧旗一竖",
      "text": "旧旗一竖，四面八方的脚步声回来了。",
      "narration": "陈胜和吴广把旧旗竖了起来，旗上写着大家心里都认得的名字 —— 扶苏、项燕。散在四面八方的人听见这个名号，又一个个回来了。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s1",
    "question": "人都散了，怎么把人叫回来？",
    "options": [
      {
        "id": "chase",
        "text": "一个个去追回来",
        "isCanonical": false,
        "hint": "人往四面八方跑，一个人追不过来。"
      },
      {
        "id": "flag",
        "text": "把旧旗竖起来",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "giveup",
        "text": "算了，散就散了吧",
        "isCanonical": false,
        "hint": "人还在，只是缺一个回来的理由。"
      }
    ],
    "reveal": "一个响亮的名号，能把散掉的人重新聚起来。"
  },
  "misconceptions": [
