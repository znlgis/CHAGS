  "story": [
    {
      "id": "s1",
      "title": "满口好话",
      "text": "他笑着说了很多好话，一句比一句好听。",
      "narration": "唐朝的李义府，跟人说话的时候总是笑着，语气又轻又暖，谁听了都觉得他是一片好心。他说的每一句话，都让人很舒服。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "出卖他的小动作",
      "text": "可是他的眼神、袖口和手指，一次一次出卖了他。",
      "narration": "话说得再好听，他的动作也在说话：眼神往旁边飘，袖口悄悄收紧了一下，手指在桌上轻轻敲。看这些的人，就知道他心里想的和嘴上说的不是一回事。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s1",
    "question": "他一直在说好话，怎么知道他真正想干什么？",
    "options": [
      {
        "id": "watch",
        "text": "看他的小动作",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "believe",
        "text": "相信他说的话",
        "isCanonical": false,
        "hint": "话是可以说给别人听的，动作很难一起装到底。"
      },
      {
        "id": "ask",
        "text": "直接问他",
        "isCanonical": false,
        "hint": "他嘴上还是那套好话 —— 问不出别的。"
      }
    ],
    "reveal": "好听的话配着他的动作一起看，才看得懂他真正想干什么。"
  },
  "misconceptions": [
    "笑得好看的人一定是好人",
    "好听的话就可以放心相信",
    "想看懂一个人，只用听他说什么"
