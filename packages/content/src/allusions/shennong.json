{
  "id": "shennong",
  "title": "神农尝百草",
  "pinyin": "shén nóng cháng bǎi cǎo",
  "kind": "legend",
  "dynasty": "上古",
  "era": "上古·传说",
  "yearApprox": -2800,
  "figures": [
    "神农",
    "炎帝"
  ],
  "source": {
    "book": "《淮南子·修务训》",
    "quote": "神农乃始教民播种五谷……尝百草之滋味，水泉之甘苦，令民知所辟就。当此之时，一日而遇七十毒。"
  },
  "moral": "他一种一种地尝，一样一样地记 —— 我们才知道什么能吃、什么能治病。",
  "keywords": [
    "尝百草",
    "记下来",
    "草药"
  ],
  "ageRange": [
    7,
    10
  ],
  "story": [
    {
      "id": "s1",
      "title": "不知道吃什么",
      "text": "上古的人靠采野果、打猎过活，吃错了东西就会生病。",
      "narration": "很久很久以前，人们靠采野果、挖草根、打猎过日子。哪些能吃，哪些能治病，谁也不知道 —— 吃错了东西，就要生病。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "尝一尝",
      "text": "神农挎着竹筐走进山里，每一种草都亲口尝一尝。",
      "narration": "有个叫神农的人，挎着竹筐走进山里。每一种草，他都要亲口尝一尝：什么味道，身上有什么反应，他一样一样记下来。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s2",
    "question": "草有没有毒，怎么才知道？",
    "options": [
      {
        "id": "others",
        "text": "让别人先尝",
        "isCanonical": false,
        "hint": ""
      },
      {
        "id": "self",
        "text": "自己尝一口，记下来",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "avoid",
        "text": "不知道的就都别碰",
        "isCanonical": false,
        "hint": ""
      }
    ],
    "reveal": "他尝过，才知道；记下来，别人就不用再尝。"
  },
  "misconceptions": [
    "有毒的草没用，尝不尝都一样",
    "野果颜色好看就能吃"
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "recall",
      "question": "神农为什么要尝百草？",
      "options": [
        "想知道哪些能吃、哪些能治病",
        "想找最好吃的果子",
        "想数一数有多少种草"
      ],
      "answer": 0,
      "explanation": "他要弄清楚：什么能吃，什么能治病，什么不能碰。"
    },
    {
      "id": "q2",
      "kind": "recall",
      "question": "尝到有毒的草，神农会怎么做？",
      "options": [
        "记下来，告诉大家不能吃",
        "扔掉它，当没尝过",
        "让别人也尝一口"
      ],
      "answer": 0,
      "explanation": "有毒也是知识：记下来，别人才不会吃错。"
    },
    {
      "id": "q3",
      "kind": "transfer",
      "question": "在山里看到不认识的野果，最像神农的做法是？",
      "options": [
        "先问大人，不认识的不吃",
        "看着好看就吃一个",
        "摘下来分给同学吃"
      ],
      "answer": 0,
      "explanation": "神农替所有人把草尝了一遍，小朋友不用冒这个险 —— 不认识的野果和蘑菇，先问大人。"
    }
  ],
