{
  "id": "dayu",
  "group": "allusion",
  "title": "大禹治水",
  "pinyin": "dà yǔ zhì shuǐ",
  "kind": "legend",
  "dynasty": "夏",
  "era": "夏·传说",
  "yearApprox": -2070,
  "figures": [
    "大禹",
    "鲧"
  ],
  "source": {
    "book": "《孟子·滕文公上》",
    "quote": "禹疏九河，瀹济漯，而注诸海。"
  },
  "moral": "堤堵不住水，就给它一条流向大海的路 —— 十三年里，他三次路过家门，都没有进去。",
  "keywords": [
    "疏不是堵",
    "开河道",
    "流向大海"
  ],
  "ageRange": [
    7,
    10
  ],
  "story": [
    {
      "id": "s1",
      "title": "洪水来了",
      "text": "洪水淹了田地，人们只好躲到山上。",
      "narration": "那一年，洪水淹了田地，冲走了庄稼。人们只好抱着孩子躲到山上，看着水一天比一天高。",
      "illustration": "none"
    },
    {
      "id": "s2",
      "title": "给水一条路",
      "text": "父亲鲧用土堵水，九年不成。禹说：水往低处走，就给它一条路。",
      "narration": "禹的父亲鲧用土去堵洪水，堤越筑越高，九年也没有成功。禹说：水往低处走，那就给它一条路。他不去堵，他去开河道。《史记》里说，他在外十三年，三次路过家门都没有进去。",
      "illustration": "none"
    }
  ],
  "keyMoment": {
    "beatId": "s2",
    "question": "水这么大，怎么办？",
    "options": [
      {
        "id": "higher",
        "text": "把堤再筑高一点",
        "isCanonical": false,
        "hint": ""
      },
      {
        "id": "road",
        "text": "给它一条流向大海的路",
        "isCanonical": true,
        "hint": ""
      },
      {
        "id": "move",
        "text": "带大家搬到更远的山上",
        "isCanonical": false,
        "hint": ""
      }
    ],
    "reveal": "堵得住一处，堵不住处处 —— 水往低处走，就给它一条路。"
  },
  "misconceptions": [
    "水只能堵，堤筑得越高越安全",
    "鲧用土堵水，九年全白费了"
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "recall",
      "question": "鲧用土堵水，为什么九年都没有成功？",
      "options": [
        "水堵得住一处，堵不住处处",
        "他筑的堤还不够高",
        "他没有找人帮忙"
      ],
      "answer": 0,
      "explanation": "水会从别的地方漫过来：光靠堵，是堵不住的。"
    },
    {
      "id": "q2",
      "kind": "recall",
      "question": "禹治水，用的是什么办法？",
      "options": [
        "开河道，把水引向大海",
        "把堤筑到天上那么高",
        "让水留在田里不动"
      ],
      "answer": 0,
      "explanation": "他不用堵，他用疏：给水一条路，让它自己往低处走。"
    },
    {
      "id": "q3",
      "kind": "transfer",
      "question": "厨房的下水道堵了，最像大禹的做法是？",
      "options": [
        "使劲往里塞，把水堵住",
        "找到堵住的地方，通开一条路",
        "不管它，等水自己退下去"
      ],
      "answer": 1,
      "explanation": "堵只会让水越积越多；找到出口、通开一条路，水才流得走。"
    }
  ],
